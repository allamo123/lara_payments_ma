{
  "name": "ma-lara/payment",
  "version": "2.0.0",
  "license": "MIT",
  "description": "A Laravel payment gateway package that provides a unified API for integrating multiple payment providers, including Stripe and Paymob, with support for payments, payment verification, retries, refunds, transactions, and webhooks.",
  "keywords": [
      "laravel",
      "payment",
      "payments",
      "payment-gateway",
      "online-payments",
      "stripe",
      "paymob",
      "paymob-mobile-wallet",
      "php"
  ],
  "autoload": {
    "psr-4": {
      "Ma\\Payment\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1",
    "laravel/framework": ">=9.0",
    "paypal/paypal-checkout-sdk": "1.0.2",
    "stripe/stripe-php": "*",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "authors": [
    {
      "name": "Mohamed Allam",
      "email": "mohamed_allam@windowslive.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Ma\\Payment\\MaPaymentServiceProvider"
      ],
      "aliases": {
        "MaPayment": "Ma\\Payment\\Facades\\MaPayment"
      }
    }
  }
}
